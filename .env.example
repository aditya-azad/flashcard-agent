# AnkiWeb credentials used by the container to sign in and sync your
# collection at startup and periodically (every 300s by default). Copy to
# .env and fill in.
ANKIWEB_EMAIL=you@example.com
ANKIWEB_PASSWORD=secret

# Optional: self-hosted Anki sync server instead of AnkiWeb.
# ANKIWEB_SYNC_URL=http://syncserver:8080

# Optional: seconds between periodic syncs (default 300).
# ANKIWEB_SYNC_INTERVAL=300

# Optional: how to resolve a sync conflict (both sides changed since the last
# sync). "cancel" (default) skips the sync and never destroys data; "upload"
# or "download" resolve it automatically.
# ANKI_SYNC_CONFLICT=cancel
